{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panel du cabinet",
  "version": "0.0.0",
  "identifier": "net.wasied.firmpanel",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Business",
    "shortDescription": "Panel du cabinet",
    "longDescription": "Le panel du cabinet comptable, dans sa propre fenêtre, toujours à jour.",
    "publisher": "Wasied",
    "copyright": "© Wasied",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        }
      },
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RUYzOUQzRTMwNjI4NzcKUldSM0tBYmowem52WkhSV2I3VDU5KzNFZU1NVXFmT3NUL2ZsYkNFaStNOU1FQTAzc0NtMW9wYzgK",
      "endpoints": [
        "https://github.com/wasied-com/firm-panel-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
